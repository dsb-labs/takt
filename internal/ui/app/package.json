{
  "name": "orca-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && touch ../dist/.gitkeep",
    "check": "vue-tsc --noEmit",
    "generate": "openapi-typescript ../../../api/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "format": "prettier --write src index.html vite.config.ts",
    "format:check": "prettier --check src index.html vite.config.ts"
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.0.0",
    "openapi-fetch": "^0.14.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
