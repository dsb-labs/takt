{
  "name": "orca-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && touch ../dist/.gitkeep",
    "check": "vue-tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "generate": "openapi-typescript ../../../api/openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "format": "prettier --write src index.html vite.config.ts",
    "format:check": "prettier --check src index.html vite.config.ts"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@tanstack/vue-query": "^5.0.0",
    "@vue-flow/core": "^1.48.2",
    "highlight.js": "^11.12.0",
    "openapi-fetch": "^0.17.0",
    "vue": "^3.5.0",
    "vue-router": "^5.3.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "openapi-typescript": "^7.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vue-tsc": "^3.0.0"
  }
}
