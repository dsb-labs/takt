[Unit]
Description=takt workload orchestrator
Documentation=https://github.com/dsb-labs/takt
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=notify
User=takt
ExecStart=/usr/bin/takt serve /etc/takt/config.toml
StateDirectory=takt
StateDirectoryMode=0700
Restart=on-failure

# Exec workloads outlive the server by design. The default control-group
# mode kills every process in the unit on stop, which takes them all down.
KillMode=process

# Resource limits on exec workloads need a delegated cgroup subtree. The
# subgroup keeps a restart working when exec workloads survive the old
# server. See the Delegation section of docs/operating.md.
Delegate=yes
DelegateSubgroup=main

# These also apply to every exec workload the server starts. They compose
# with the kernel confinement described in docs/operating.md: the system
# directories stay readable, and the data directory stays writable.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

# Connecting to the docker socket needs a writable path, which
# ProtectSystem=strict otherwise removes. The dash lets the unit start on a
# host without the socket, since a server running only exec workloads
# needs no daemon.
ReadWritePaths=-/run/docker.sock

# CAP_DAC_OVERRIDE lets the server delete volume files a container wrote as
# another user. CAP_CHOWN lets it assign a volume's directory to the user a
# volume manifest names. CAP_FOWNER lets it change the mode of a directory it
# assigned away, which is what updating an owned volume's mode is.
# CAP_SETGID lets an exec workload drop the groups the takt user is in, the
# docker group above all, before its command runs. Without it the server
# refuses exec workloads rather than hand each one the socket. All four are
# dropped before an exec workload's command runs, so no workload holds them.
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER CAP_SETGID

[Install]
WantedBy=multi-user.target
